; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AeroBeat Camera Tracking Testbed"
run/main_scene="uid://83jxycoubyxd"
config/features=PackedStringArray("4.6")

[autoload]

AeroHeadlessManager="*res://addons/aerobeat-tool-headless-manager/src/AeroHeadlessManager.gd"
AeroCameraTracking="*res://addons/aerobeat-input-camera-tracking/src/AeroCameraTracking.gd"

[config]

features=PackedStringArray("4.6", "Forward Plus")
icon="res://icon.svg"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/aerobeat-input-core/plugin.cfg")
